{
  "name": "natlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot serve.ts",
    "build": "tsc --noEmit && rm -rf dist && bun build ./index.html --outdir dist --minify && cp -r public/. dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "proto": "scripts/gen-proto.sh",
    "data": "cd export && uv run synthetic.py",
    "live": "cd export && uv run serve.py",
    "scribe": "cd export && uv run scribe.py"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": "https://github.com/khoda81/natlas"
}
