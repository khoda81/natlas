{
  "name": "natlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "core": "wasm-pack build core --target web --out-dir ../src/core/generated --out-name natlas_core --release",
    "predev": "bun run core",
    "dev": "bun --hot serve.ts",
    "prebuild": "bun run core",
    "build": "tsc --noEmit && rm -rf dist && bun build ./index.html --outdir dist --minify && cp -r public/. dist/ && mkdir -p dist/generated && cp src/core/generated/natlas_core_bg.wasm dist/generated/",
    "pretest": "bun run core",
    "test": "bun test && cargo test --manifest-path core/Cargo.toml && uv run tests/server_test.py",
    "pretypecheck": "bun run core",
    "typecheck": "tsc --noEmit",
    "proto": "scripts/gen-proto.sh",
    "data": "cd export && uv run synthetic.py",
    "live": "cd export && uv run serve.py",
    "scribe": "cd export && uv run scribe.py"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": "https://github.com/khoda81/natlas"
}
